# ─────────────────────────────────────────────────────────────────────────────
# Slingshot Advisory — environment configuration
# Copy to `.env.local` (dev) or set in your host (Netlify/Vercel) for production.
# Nothing here is required to run the marketing site. The intake API degrades
# gracefully: with no email provider configured it returns an honest "not yet
# live" response (the form then offers a pre-filled email), and in development
# it also logs leads to ./.leads/*.jsonl so you can test end to end.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL — used for canonical/OG/sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://slingshotadvisory.com

# ── Email workflow (Resend) ──────────────────────────────────────────────────
# When set, the intake API sends a branded acknowledgment to the client and a
# lead notification to the owner. Get a key at https://resend.com.
RESEND_API_KEY=
# Verified sender (must be a domain verified in Resend), and where leads go.
LEAD_FROM_EMAIL=Slingshot Advisory <hello@slingshotadvisory.com>
LEAD_NOTIFY_EMAIL=andrew@slingshotadvisory.com

# ── Lead / order storage (optional) ──────────────────────────────────────────
# Post each validated lead AND website order to a webhook (e.g. a Zapier/Make
# hook, or your own endpoint that writes to Supabase/Postgres). Leave blank to
# skip; in dev, leads/orders are also logged to ./.leads and ./.orders.
LEAD_WEBHOOK_URL=

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
# When set, the "Build My Website" flow creates a real Stripe Checkout session
# ($500 Starter fee, or $500 deposit for the $750 Business Website+). With no key
# the flow saves the order, notifies the owner, and shows a "payment not connected"
# state (never a fake success). Keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret — REQUIRED to mark orders paid. Create an endpoint at
# {your-domain}/api/stripe/webhook for the event `checkout.session.completed`.
STRIPE_WEBHOOK_SECRET=

# ── Scheduling ────────────────────────────────────────────────────────────────
# No live-calendar integration yet: the strategy-call page collects preferred
# times and emails the owner (marked "pending confirmation"). To add real
# booking, integrate a provider (e.g. Cal.com/Calendly) in app/get-started/schedule.

# ── AI assistant (optional) ──────────────────────────────────────────────────
# If set, the assistant can answer from the curated knowledge base via a secure
# server route. If blank, the assistant runs as a structured FAQ (no LLM).
ANTHROPIC_API_KEY=
